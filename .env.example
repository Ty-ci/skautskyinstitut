DATABASE_URI=            # Neon pooled connection string (dev branch/local DB only - never production)
PAYLOAD_SECRET=          # openssl rand -hex 32
NEXT_PUBLIC_SERVER_URL=  # public site URL, e.g. http://localhost:3000
S3_BUCKET=               # leave empty locally to store uploads on disk
S3_ENDPOINT=             # https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The site's spreadsheet – tabs events, dashboard, keys (share it with the service account as Editor,
# the dashboard writes into it)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=      # the service account's private key, newlines escaped as \n
GOOGLE_SHEET_ID=         # optional, defaults to the production sheet; set to a copy for testing
                         # (the older name GOOGLE_EVENTS_SHEET_ID still works)
# Phase 3 only:
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
